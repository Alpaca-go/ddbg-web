{
  "name": "ddbg",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24.21.0 <25",
    "pnpm": ">=12.9.1 <13"
  },
  "scripts": {
    "dev": "pnpm --filter @ddbg/web dev",
    "build": "pnpm --filter @ddbg/web build",
    "typecheck": "tsc -p packages/engine && tsc -p packages/data && tsc -p tools/pipeline && tsc -p apps/web",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "pnpm --filter @ddbg/web test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}
